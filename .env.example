# Configure exactly one token source. Never commit an actual credential.
# RELEEM_SECRET_KEY=<YOUR_API_TOKEN> is an alternative to token file/token env.
RELEEM_API_TOKEN_FILE=/absolute/path/to/releem-token
RELEEM_API_BASE_URL=https://api2.dev.releem.com
RELEEM_MCP_READ_ONLY=true
RELEEM_MCP_PROFILE=local
RELEEM_MCP_MAX_OUTPUT_BYTES=24576
# Optional opt-in for minimized incident detail and historical capture aggregates:
RELEEM_MCP_SENSITIVE_DETAILS=false
# Optional administrator configuration:
# RELEEM_API_CA_BUNDLE=/absolute/path/to/enterprise-ca.pem
# HTTPS_PROXY=https://proxy.example.invalid:8443
# RELEEM_API_ALLOW_PRIVATE=true

# Hosted uses a SEPARATE configuration file with NO customer token variables.
# RELEEM_MCP_PROFILE=hosted
# RELEEM_MCP_PUBLIC_URL=https://mcp.example.invalid/mcp
# RELEEM_MCP_BIND_HOST=127.0.0.1
# RELEEM_MCP_PORT=8000
# RELEEM_MCP_REQUESTS_PER_MINUTE=60
# RELEEM_MCP_MAX_CONCURRENT_REQUESTS=16
# RELEEM_MCP_PER_KEY_CONCURRENCY=4

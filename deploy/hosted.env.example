# Administrator settings only; never put customer API keys here.
RELEEM_MCP_PUBLIC_URL=https://mcp.example.invalid/mcp
RELEEM_API_BASE_URL=https://api2.releem.com
MCP_RELEEM_HOST_PORT=8000
# Use an approved immutable image ID/digest for a deployed release.
MCP_RELEEM_IMAGE=mcp-releem:hosted
RELEEM_MCP_SENSITIVE_DETAILS=false
# Enable only after the token file is installed; start-tunnel.sh sets this on the host.
# COMPOSE_PROFILES=tunnel
RELEEM_MCP_MAX_OUTPUT_BYTES=24576
RELEEM_MCP_REQUESTS_PER_MINUTE=60
RELEEM_MCP_MAX_CONCURRENT_REQUESTS=16
RELEEM_MCP_PER_KEY_CONCURRENCY=4
